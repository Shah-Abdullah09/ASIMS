DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL (set DB_ENGINE=sqlite only for a quick local check)
DB_ENGINE=postgres
DB_NAME=asims
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Production (DJANGO_DEBUG=False): a long random DJANGO_SECRET_KEY is required (40+ characters). HTTPS redirect,
# secure cookies and HSTS (30 days) switch on automatically. Behind an HTTPS proxy such as nginx:
# DJANGO_BEHIND_PROXY=True
# DJANGO_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=2592000

# Rate limits per client address (defaults shown)
# RATE_LOGIN=10/minute
# RATE_REGISTER=10/hour
# RATE_PASSWORD_FORGOT=5/hour

# Real email (otherwise emails are printed in the backend console)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=ASIMS <you@example.com>

